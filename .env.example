# Copia questo file in .env.local per lo sviluppo locale.
# NON committare mai .env.local o valori reali di questo file.

# --- Pubbliche (esposte al browser: solo URL e anon/publishable key) -------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# URL pubblico dell'app, usato per costruire il redirect del magic link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LemonSqueezy (checkout + webhook entitlements) ---------------------
# Da un account/store LemonSqueezy: Settings > API per la chiave, Stores
# per lo store id, la pagina del prodotto per il variant id da vendere.
# Finche' sono vuote, il checkout mostra un messaggio invece di rompersi.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# --- Solo Edge Function (supabase/functions/lemonsqueezy-webhook) ------
# Configurala come secret del progetto Supabase (supabase secrets set),
# mai come variabile Vercel: la firma HMAC del webhook la verifica lì.
LEMONSQUEEZY_WEBHOOK_SECRET=
