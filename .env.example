# Copia questo file in .env.local per lo sviluppo locale.
# NON committare mai .env.local o valori reali di questo file.

# --- Pubbliche (esposte al browser: solo URL e anon/publishable key) -------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# URL pubblico dell'app, usato per costruire il redirect del magic link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo server -------------------------------------------------------
# Unico indirizzo autorizzato ad amministrare l'app (deve combaciare con
# private.admin_config.email nel database, vedi supabase/migrations).
ADMIN_EMAIL=admin@esempio.com

# --- Solo Edge Function (supabase/functions/daily-notifications) -------
# NON usate dall'app Next.js: configurale come "secrets" del progetto
# Supabase (supabase secrets set ...), mai come variabili Vercel.
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY sono già disponibili di default
# in ogni Edge Function.
RESEND_API_KEY=re_...
NOTIFICATIONS_FROM_EMAIL=quota@tuodominio.com
NOTIFICATIONS_TO_EMAIL=admin@esempio.com
